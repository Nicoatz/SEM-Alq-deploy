PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Orígenes permitidos por CORS: una URL o varias separadas por coma.
# Sin valor, solo http://localhost:3001 (apps/web en desarrollo).
CORS_ORIGIN=http://localhost:3001

# ─── DocuSign (US-07, firma de contratos) ───
# Cuenta de desarrollador (sandbox). Ver paso_paso_docusing.md, Paso 0.
DOCUSIGN_INTEGRATION_KEY=
# GUID del usuario de DocuSign que se impersona (el que "envía" los sobres).
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Clave privada RSA en PEM. En una sola línea, con los saltos de línea escritos como \n.
DOCUSIGN_PRIVATE_KEY=
# Sandbox por defecto. Para producción: account.docusign.com y la base URI de la cuenta.
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
# Clave HMAC de DocuSign Connect, para verificar los avisos (webhook). Sin ella se rechazan todos.
DOCUSIGN_CONNECT_HMAC_KEY=
# URL pública de esta API donde DocuSign avisa las firmas, por ejemplo la de un túnel (ngrok) en
# desarrollo: https://xxxx.ngrok-free.app/api/v1/webhooks/docusign
DOCUSIGN_WEBHOOK_URL=
# URL pública del front: a ella vuelve el usuario después de firmar.
WEB_URL=http://localhost:3001
