# Variables de entorno de apps/web. Copiar a apps/web/.env.local para cambiarlas
# (.env.local no se commitea). Sin archivo, valen los valores por defecto de abajo.

# true (por defecto): los services devuelven datos del elenco (lib/mocks) con
# latencia simulada. false: llaman a apps/api. Ver services/shared/config.ts.
NEXT_PUBLIC_USE_MOCKS=true

# URL base de la API versionada (apps/api corre en el puerto 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Supabase Auth (solo con NEXT_PUBLIC_USE_MOCKS=false): la sesión real vive en
# Supabase y cada request a la API lleva su token (Authorization: Bearer).
# Se sacan del panel de Supabase: Project Settings → API. La clave es la
# PUBLICABLE (sb_publishable_…), que es pública a propósito.
# NUNCA poner acá la SUPABASE_SECRET_KEY: saltea RLS y es solo del back.
NEXT_PUBLIC_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
